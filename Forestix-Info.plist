<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- FIELD-DATA ESCAPE HATCH. The raw-capture corpus lives in the app's
	     Documents folder; without these two keys the only route off the
	     phone is the share sheet, so a corpus too big to share is stranded.
	     With them the folder is browsable in Finder / the Files app and the
	     day's captures can always be pulled off by hand. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
</dict>
</plist>
